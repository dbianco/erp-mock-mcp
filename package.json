{
  "name": "erp-mock-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Odoo-style product catalog exposed as an MCP server (Textra feature 025).",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:catalog": "tsx scripts/build-catalog.ts",
    "check:images": "tsx scripts/check-images.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
